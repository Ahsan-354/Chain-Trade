{
  "name": "chaintrade",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "chain": "npm run node -w @chaintrade/contracts",
    "deploy": "npm run deploy -w @chaintrade/contracts",
    "db:generate": "npm run db:generate -w @chaintrade/api",
    "db:migrate": "npm run db:migrate -w @chaintrade/api",
    "seed": "npm run seed -w @chaintrade/api",
    "dev": "concurrently -k -n api,web \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev -w @chaintrade/api",
    "dev:web": "npm run dev -w @chaintrade/web",
    "test": "npm run test:contracts && npm run test:api",
    "test:contracts": "npm run test -w @chaintrade/contracts",
    "test:api": "npm run test -w @chaintrade/api",
    "test:web": "npm run test -w @chaintrade/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "concurrently": "9.2.1",
    "eslint": "9.39.2",
    "globals": "16.5.0",
    "prettier": "3.7.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.49.0"
  }
}
